# BPS Web API key (https://webapi.bps.go.id/developer/ -> register application)
WEBAPI_BPS_KEY=

# optional
# DATA_DIR=./data          # PDFs + library.db
# MAX_PDF_MB=250
# JOB_WORKERS=2           # extraction jobs running at the same time (the rest wait)
# JOBS_PER_USER=2         # documents one user may have queued / running at once

# ---- login (see README, "Login and access")
# first admin, created at startup if that user does not exist yet (password login, no Google needed)
ADMIN_USER=admin
ADMIN_PASSWORD=
# Google login (optional): OAuth client of type "Web application" in the Google Cloud console,
# redirect URI = PUBLIC_URL + /api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# PUBLIC_URL=https://tabel-dari-pdf.statapps.dev
# SESSION_DAYS=7
# requests per minute per IP for visitors who are not logged in
# RATE_PUBLIC=300
# RATE_PUBLIC_FILES=30
