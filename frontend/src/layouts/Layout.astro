---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { EARLY } from '../lib/auth';

interface Props { title: string; active?: 'library' | 'search' | 'tables' | 'doc' | 'queue' | 'settings' | 'users' | 'login'; full?: boolean; wide?: boolean }
const { title, active, full = false, wide = false } = Astro.props;
// the workspace of a document belongs to the Library
const current = active === 'doc' ? 'library' : active;
const nav = [
  { id: 'library', href: '/', label: 'Library' },
  { id: 'tables', href: '/tables', label: 'Tables' },
  { id: 'search', href: '/import-from-bps', label: 'BPS Catalog', need: 'editor' },
];
---
<!doctype html>
<html lang="id" translate="no" class="notranslate">
  <head>
    <meta charset="utf-8" />
    <!-- the remembered login role, before the first paint (no flash of edit buttons for visitors) -->
    <script is:inline set:html={EARLY} />
    <!-- content is Indonesian statistics: never offer browser translation (Firefox / Chrome) -->
    <meta name="google" content="notranslate" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Tabel dari PDF</title>
    <!-- link previews (WhatsApp, Telegram, Slack, ...) -->
    <meta name="description" content="Ambil tabel dari PDF publikasi dan BRS BPS, rapikan, lalu unduh ke Excel, CSV, atau JSON." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tabel dari PDF" />
    <meta property="og:title" content="Tabel dari PDF: tabel publikasi BPS siap Excel" />
    <meta property="og:description" content="Cari publikasi atau BRS BPS, impor PDF-nya, tabel ditemukan otomatis, rapikan, lalu unduh ke Excel, CSV, atau JSON." />
    <meta property="og:locale" content="id_ID" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body class={full ? 'h-dvh flex flex-col overflow-hidden' : ''}>
    <!-- phones are not supported (needs a PDF and a grid side by side): CSS shows this instead of the app -->
    <div id="small-screen" role="alert">
      <div class="max-w-[22rem] text-center">
        <span class="mx-auto mb-4 grid place-items-center size-12 bg-accent-500 text-white" aria-hidden="true"><Icon name="table" class="size-6" /></span>
        <h1 class="text-[17px] font-semibold text-ink-900">Tabel dari PDF needs a bigger screen</h1>
        <p class="mt-2 text-[13.5px] text-ink-600">Open it on a computer or a tablet. Checking tables needs the PDF page and the table editor side by side, which does not fit on a phone.</p>
        <p class="mt-2 text-[13px] text-ink-500">Buka di komputer atau tablet. Layar ponsel terlalu kecil untuk aplikasi ini.</p>
      </div>
    </div>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[80] focus:bg-surface focus:text-ink-900 focus:px-3 focus:py-2 focus:border focus:border-brand-500">Skip to Content</a>
    <!-- top bar: one navy strip, text only (no icons), like a classic enterprise webmail -->
    <header class="topbar h-9 shrink-0 flex items-stretch text-[13px] select-none">
      <a href="/" class="flex items-center gap-[9px] pl-3.5 pr-[18px] text-white font-bold text-[14px] tracking-[.01em]">
        <span class="size-3.5 bg-white" aria-hidden="true"></span>Tabel dari PDF</a>
      <nav class="flex" aria-label="Main">
        {nav.map((n) => (
          <a href={n.href} aria-current={current === n.id ? 'page' : undefined} data-need={n.need} class="topbar-link">{n.label}</a>
        ))}
      </nav>
      <span class="flex-1"></span>
      <span id="health" role="status" class="flex items-center gap-md px-3 text-[12px]"></span>
      <slot name="header-right" />
      <a href="/queue" id="queue-link" data-need="editor" aria-current={current === 'queue' ? 'page' : undefined} class="topbar-link gap-[7px]">
        Queue<span id="queue-badge" class="topbar-badge hidden" aria-live="polite"></span></a>
      <span class="topbar-user flex items-center pl-1.5 pr-3.5 ml-1">
        <a href="/settings" title="Settings (saved in this browser only)" aria-current={current === 'settings' ? 'page' : undefined} class="topbar-text">Settings</a>
        <span class="w-px h-3.5 bg-[var(--nav-sep)]" aria-hidden="true"></span>
        <a href="/login" id="login-link" data-need="public" class="topbar-text">Log In</a>
        <button id="user-btn" type="button" class="topbar-text hidden" aria-haspopup="menu">
          <span id="user-name" class="max-w-48 truncate [font-variant:small-caps] tracking-[.06em] font-semibold text-white"></span></button>
      </span>
    </header>
    <main id="main" tabindex="-1" class={full ? 'flex-1 min-h-0 flex flex-col' : wide ? 'max-w-[2000px] mx-auto px-6 py-6' : 'max-w-[1400px] mx-auto px-6 py-6'}>
      <slot />
    </main>
    <script>
      import { api } from '../lib/api';
      import { initTooltips, contextMenu, toastError } from '../lib/ui';
      import { me, logout, loginUrl, canEdit } from '../lib/auth';
      initTooltips();

      // login state in the header
      const userBtn = document.getElementById('user-btn')!;
      const loginLink = document.getElementById('login-link') as HTMLAnchorElement;
      if (location.pathname !== '/login') loginLink.href = loginUrl();
      me().then(({ user }) => {
        if (!user) return;
        userBtn.classList.replace('hidden', 'flex');
        document.getElementById('user-name')!.textContent = user.name.toLowerCase();
        userBtn.title = `${user.name} (${user.role}) · ${user.username ?? user.email ?? ''} · logged in with ${user.login_method === 'google' ? 'Google' : 'a password'}`;
        userBtn.addEventListener('click', () => contextMenu(userBtn, [
          { heading: `${user.email ?? user.username ?? user.name} · ${user.role}` },
          ...(user.role === 'admin' ? [{ label: 'Users', icon: 'users', action: () => (location.href = '/users') }] : []),
          { label: 'My Account', icon: 'lock', action: () => (location.href = '/users#me') },
          'sep',
          { label: 'Log Out', icon: 'logout', action: async () => {
            try { await logout(); location.href = '/'; } catch (e) { toastError(e); }
          } },
        ]));
      });
      const el = document.getElementById('health')!;
      async function check() {
        el.innerHTML = '';
        try {
          const h = await api.health();
          if (!h.bps_key) el.innerHTML = `<span title="Add WEBAPI_BPS_KEY=… to the .env file next to README.md, then restart the server">BPS catalog unavailable: API key missing</span>`;
        } catch {
          el.innerHTML = `<span class="font-semibold text-white">Server not reachable</span>
            <button id="hretry" class="btn btn-sm !h-6 border-white/40 text-white hover:bg-white/10">Retry</button>`;
          document.getElementById('hretry')!.addEventListener('click', check);
        }
      }
      check();

      // Queue badge: waiting and running imports / table searches (editors only); faster while something runs
      const badge = document.getElementById('queue-badge')!;
      let qTimer: ReturnType<typeof setTimeout> | undefined;
      async function queueCount() {
        clearTimeout(qTimer);
        if (!canEdit()) return;
        let next = 15000;
        try {
          const c = await api.queueCount();
          badge.textContent = String(c.active);
          badge.classList.toggle('hidden', !c.active);
          document.getElementById('queue-link')!.title = c.paused ? 'The queue is paused' : c.active ? `${c.active} waiting or running` : 'Nothing waiting';
          if (c.active) next = 4000;
        } catch { /* the health check reports a server that is down */ }
        if (!document.hidden) qTimer = setTimeout(queueCount, next);
      }
      me().then(queueCount);
      addEventListener('tdp-queue', () => queueCount()); // something was added (BPS catalog, upload)
      document.addEventListener('visibilitychange', () => { if (!document.hidden) queueCount(); });
    </script>
  </body>
</html>
