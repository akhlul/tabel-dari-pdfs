---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { EARLY } from '../lib/auth';

interface Props { title: string; active?: 'library' | 'search' | 'tables' | 'doc' | 'settings' | 'users' | 'login'; full?: boolean; wide?: boolean }
const { title, active, full = false, wide = false } = Astro.props;
const nav = [
  { id: 'library', href: '/', label: 'Library', icon: 'library' },
  { id: 'tables', href: '/tables', label: 'Tables', icon: 'grid' },
  { id: 'search', href: '/search', label: 'Search BPS', icon: 'search', need: 'editor' },
];
---
<!doctype html>
<html lang="id" translate="no" class="notranslate">
  <head>
    <meta charset="utf-8" />
    <!-- the remembered login role, before the first paint (no flash of edit buttons for visitors) -->
    <script is:inline set:html={EARLY} />
    <!-- content is Indonesian statistics: never offer browser translation (Firefox / Chrome) -->
    <meta name="google" content="notranslate" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Tabel dari PDF</title>
    <!-- link previews (WhatsApp, Telegram, Slack, ...) -->
    <meta name="description" content="Ambil tabel dari PDF publikasi dan BRS BPS, rapikan, lalu unduh ke Excel, CSV, atau JSON." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tabel dari PDF" />
    <meta property="og:title" content="Tabel dari PDF: tabel publikasi BPS siap Excel" />
    <meta property="og:description" content="Cari publikasi atau BRS BPS, impor PDF-nya, tabel ditemukan otomatis, rapikan, lalu unduh ke Excel, CSV, atau JSON." />
    <meta property="og:locale" content="id_ID" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body class={full ? 'h-dvh flex flex-col overflow-hidden' : ''}>
    <!-- phones are not supported (needs a PDF and a grid side by side): CSS shows this instead of the app -->
    <div id="small-screen" role="alert">
      <div class="max-w-[22rem] text-center">
        <span class="mx-auto mb-4 grid place-items-center size-12 bg-accent-500 text-white" aria-hidden="true"><Icon name="table" class="size-6" /></span>
        <h1 class="text-[17px] font-semibold text-ink-900">Tabel dari PDF needs a bigger screen</h1>
        <p class="mt-2 text-[13.5px] text-ink-600">Open it on a computer or a tablet. Checking tables needs the PDF page and the table editor side by side, which does not fit on a phone.</p>
        <p class="mt-2 text-[13px] text-ink-500">Buka di komputer atau tablet. Layar ponsel terlalu kecil untuk aplikasi ini.</p>
      </div>
    </div>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[80] focus:bg-surface focus:text-ink-900 focus:px-3 focus:py-2 focus:border focus:border-brand-500">Skip to Content</a>
    <header class="h-12 shrink-0 bg-header text-white flex items-center px-4 gap-6 border-b border-brand-900">
      <a href="/" class="flex items-center gap-2.5 font-semibold tracking-tight">
        <span class="grid place-items-center size-7 bg-accent-500 text-white" aria-hidden="true"><Icon name="table" class="size-4" /></span>
        <span class="text-[15px]">Tabel dari PDF</span>
      </a>
      <nav class="flex h-full">
        {nav.map((n) => (
          <a href={n.href} aria-current={active === n.id ? 'page' : undefined} data-need={n.need}
             class:list={['flex items-center gap-md px-3 h-full text-[13px] border-b-2 transition-colors',
               active === n.id ? 'border-white text-white font-semibold' : 'border-transparent text-white/75 hover:text-white']}>
            <Icon name={n.icon} class="size-4" />{n.label}
          </a>
        ))}
      </nav>
      <div class="ml-auto flex items-center gap-lg text-[12px] text-white/80">
        <slot name="header-right" />
        <!-- HIG: only show status when something needs attention -->
        <span id="health" role="status" class="flex items-center gap-md"></span>
        <a href="/settings" title="Settings (saved in this browser only)" aria-current={active === 'settings' ? 'page' : undefined}
           class:list={['flex items-center gap-md px-2 h-8 text-[13px]', active === 'settings' ? 'text-white font-semibold' : 'text-white/75 hover:text-white']}>
          <Icon name="settings" class="size-4" /><span class="hidden md:inline">Settings</span></a>
        <a href="/login" id="login-link" data-need="public" class="flex items-center gap-md px-2 h-8 text-[13px] text-white/90 hover:text-white border border-white/30 hover:bg-white/10">
          <Icon name="login" class="size-4" />Log In</a>
        <button id="user-btn" type="button" class="hidden items-center gap-md px-2 h-8 text-[13px] text-white/90 hover:text-white hover:bg-white/10" aria-haspopup="menu">
          <Icon name="user" class="size-4" /><span id="user-name" class="max-w-40 truncate"></span>
          <span id="user-role" class="text-[10.5px] uppercase tracking-wider px-1 border border-white/40 text-white/80"></span></button>
      </div>
    </header>
    <main id="main" tabindex="-1" class={full ? 'flex-1 min-h-0 flex flex-col' : wide ? 'max-w-[2000px] mx-auto px-6 py-6' : 'max-w-[1400px] mx-auto px-6 py-6'}>
      <slot />
    </main>
    <script>
      import { api } from '../lib/api';
      import { icon } from '../lib/icons';
      import { initTooltips, contextMenu, toastError } from '../lib/ui';
      import { me, logout, loginUrl } from '../lib/auth';
      initTooltips();

      // login state in the header
      const userBtn = document.getElementById('user-btn')!;
      const loginLink = document.getElementById('login-link') as HTMLAnchorElement;
      if (location.pathname !== '/login') loginLink.href = loginUrl();
      me().then(({ user }) => {
        if (!user) return;
        userBtn.classList.replace('hidden', 'flex');
        document.getElementById('user-name')!.textContent = user.name;
        document.getElementById('user-role')!.textContent = user.role;
        userBtn.title = `${user.username ?? user.email ?? ''} · logged in with ${user.login_method === 'google' ? 'Google' : 'a password'}`;
        userBtn.addEventListener('click', () => contextMenu(userBtn, [
          { heading: user.email ?? user.username ?? user.name },
          ...(user.role === 'admin' ? [{ label: 'Users', icon: 'users', action: () => (location.href = '/users') }] : []),
          { label: 'My Account', icon: 'lock', action: () => (location.href = '/users#me') },
          'sep',
          { label: 'Log Out', icon: 'logout', action: async () => {
            try { await logout(); location.href = '/'; } catch (e) { toastError(e); }
          } },
        ]));
      });
      const el = document.getElementById('health')!;
      async function check() {
        el.innerHTML = '';
        try {
          const h = await api.health();
          if (!h.bps_key) el.innerHTML = `<span class="text-amber-400">${icon('dot', 'size-3')}</span>
            <span title="Add WEBAPI_BPS_KEY=… to the .env file next to README.md, then restart the server">BPS search unavailable: API key missing</span>`;
        } catch {
          el.innerHTML = `<span class="text-red-400">${icon('x', 'size-3.5')}</span><span>Server not reachable</span>
            <button id="hretry" class="btn btn-sm border-white/40 text-white hover:bg-white/10">Retry</button>`;
          document.getElementById('hretry')!.addEventListener('click', check);
        }
      }
      check();
    </script>
  </body>
</html>
