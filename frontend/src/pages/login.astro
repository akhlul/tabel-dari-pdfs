---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---
<Layout title="Log In" active="login">
  <div class="max-w-[24rem] mx-auto mt-10">
    <div class="panel p-6">
      <h1 class="text-xl font-semibold text-ink-900 tracking-tight flex items-center gap-lg"><Icon name="lock" class="size-5 text-ink-500" />Log In</h1>
      <p class="text-[13px] text-ink-600 mt-1">Editors and admins log in to import PDFs, find and fix tables. Without logging in you can view and download the tables marked valid.</p>

      <p id="err" role="alert" class="hidden mt-4 px-3 py-2 border border-red-200 bg-red-50 text-[13px] text-red-800"></p>

      <div id="google" class="hidden mt-5">
        <a id="google-btn" href="/api/auth/google/start" class="btn-line w-full justify-center h-10">
          <svg class="size-4" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.4h6.5a5.6 5.6 0 0 1-2.4 3.6v3h3.9c2.3-2.1 3.5-5.2 3.5-8.7z"/><path fill="#34A853" d="M12 24c3.2 0 6-1.1 8-2.9l-3.9-3c-1.1.7-2.5 1.2-4.1 1.2-3.1 0-5.8-2.1-6.7-5H1.3v3.1A12 12 0 0 0 12 24z"/><path fill="#FBBC05" d="M5.3 14.3a7.2 7.2 0 0 1 0-4.6V6.6H1.3a12 12 0 0 0 0 10.8z"/><path fill="#EA4335" d="M12 4.8c1.8 0 3.3.6 4.6 1.8l3.4-3.4A12 12 0 0 0 1.3 6.6l4 3.1c.9-2.8 3.6-4.9 6.7-4.9z"/></svg>
          Log In with Google</a>
        <p class="mt-1.5 text-[11.5px] text-ink-500">Only for Google accounts an admin has added.</p>
        <div class="flex items-center gap-lg my-5 text-[11px] uppercase tracking-wider text-ink-400"><span class="flex-1 border-t border-ink-200"></span>or with a password<span class="flex-1 border-t border-ink-200"></span></div>
      </div>

      <form id="form" class="grid gap-4 mt-5">
        <div>
          <label for="username" class="label">User name</label>
          <input id="username" name="username" class="field w-full" autocomplete="username" required autofocus />
        </div>
        <div>
          <label for="password" class="label">Password</label>
          <input id="password" name="password" type="password" class="field w-full" autocomplete="current-password" required />
        </div>
        <button id="submit" class="btn-primary h-10 justify-center"><Icon name="login" class="size-4" />Log In</button>
      </form>
    </div>
    <p class="mt-3 text-center text-[12.5px]"><a href="/" class="text-brand-600 hover:underline">Continue without logging in</a></p>
  </div>
</Layout>

<script>
  import { $, esc } from '../lib/ui';
  import { icon } from '../lib/icons';
  import { me, login, googleUrl } from '../lib/auth';

  const params = new URLSearchParams(location.search);
  const raw = params.get('next') || '/';
  const next = raw.startsWith('/') && !raw.startsWith('//') && !raw.startsWith('/login') ? raw : '/';
  const ERRORS: Record<string, string> = {
    not_registered: 'This Google account has no access. Ask an admin to add {email}.',
    google_cancelled: 'Google login was cancelled.',
    google_state: 'The Google login took too long or was started in another tab. Try again.',
    google_token: 'Google did not confirm the login. Try again.',
    google_email: 'This Google account has no verified e-mail address.',
    google_unreachable: 'Google could not be reached from the server. Try again later.',
  };
  function showError(msg: string) {
    const e = $('#err');
    e.innerHTML = msg;
    e.classList.remove('hidden');
  }
  const code = params.get('error');
  if (code) showError(esc(ERRORS[code] ?? 'Logging in failed.').replace('{email}', `<b>${esc(params.get('email') ?? 'it')}</b>`));

  me().then((m) => {
    if (m.user) { location.replace(next); return; }
    if (m.google) {
      $('#google').classList.remove('hidden');
      $<HTMLAnchorElement>('#google-btn').href = googleUrl(next);
    }
  });

  $('#form').addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const b = $<HTMLButtonElement>('#submit');
    b.disabled = true;
    b.innerHTML = `${icon('spinner', 'size-4')}Logging in…`;
    $('#err').classList.add('hidden');
    try {
      await login($<HTMLInputElement>('#username').value.trim(), $<HTMLInputElement>('#password').value);
      location.replace(next);
    } catch (e: any) {
      showError(esc(e.message));
      $<HTMLInputElement>('#password').select();
      b.disabled = false;
      b.innerHTML = `${icon('login', 'size-4')}Log In`;
    }
  });
</script>
