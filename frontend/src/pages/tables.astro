---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---
<Layout title="Tables" active="tables" wide>
  <div class="flex flex-wrap items-end justify-between gap-grid mb-5">
    <div>
      <h1 class="text-xl font-semibold text-ink-900 tracking-tight">Tables</h1>
      <p class="text-[13px] text-ink-600 mt-0.5">Every table in your library, with the document, page and area it comes from.</p>
    </div>
    <div class="toolbar">
      <div class="relative">
        <span class="absolute left-2.5 top-2 text-ink-400" aria-hidden="true"><Icon name="search" /></span>
        <input id="q" type="search" aria-label="Search tables" class="field w-72 pl-8" placeholder="Search titles, notes and documents" />
      </div>
      <label class="flex items-center gap-md text-[12.5px] text-ink-700">Sort by:
        <select id="sort" class="field">
          <option value="document">Document and page</option>
          <option value="recent">Recently changed</option>
        </select>
      </label>
    </div>
  </div>

  <div class="flex gap-grid items-start">
    <!-- filters -->
    <aside class="w-80 shrink-0 panel sticky top-4 max-h-[calc(100dvh-2rem)] overflow-y-auto" aria-label="Filters">
      <fieldset class="min-w-0 px-2 pt-3 pb-2">
        <legend class="flex w-full items-center px-2 mb-1"><span class="label !mb-0">Flag</span></legend>
        <div id="f-state"></div>
      </fieldset>
      <div class="border-t border-ink-100 px-2 py-2" id="f-edited"></div>
      <fieldset class="min-w-0 border-t border-ink-100 px-2 pt-3 pb-2">
        <legend class="px-2 mb-1 label !mb-1">Source type</legend>
        <div id="f-kind"></div>
      </fieldset>
      <fieldset class="min-w-0 border-t border-ink-100 px-2 pt-3 pb-3">
        <legend class="px-2 label !mb-1">Category and document</legend>
        <input id="f-docq" type="search" aria-label="Find a document in the filter" placeholder="Find a document" class="field w-[calc(100%-1rem)] mx-2 mb-1.5 h-7 text-[12px]" />
        <div id="f-docs" class="max-h-[28rem] overflow-y-auto"></div>
      </fieldset>
      <div class="border-t border-ink-100 px-4 py-2"><button id="reset" class="btn-ghost btn-sm w-full">Reset Filters</button></div>
    </aside>

    <!-- results -->
    <section class="flex-1 min-w-0" aria-label="Results">
      <div class="flex flex-wrap items-center gap-lg mb-2 min-h-9">
        <label class="flex items-center gap-lg text-[12.5px] text-ink-700">
          <input id="selall" type="checkbox" class="accent-brand-700" />Select all shown
        </label>
        <h2 id="summary" class="text-[12px] font-semibold uppercase tracking-wider text-ink-500" aria-live="polite"></h2>
        <div id="bulk" role="toolbar" aria-label="Selected tables" class="hidden ml-auto flex flex-wrap items-center gap-sm panel px-2 py-1 border-brand-300">
          <span id="bulkn" class="text-[12px] font-semibold text-ink-900 px-1"></span>
          <button data-bulk="valid" class="btn-ghost btn-sm"><Icon name="flagOk" class="size-3.5 text-emerald-600" />Flag as Valid</button>
          <button data-bulk="invalid" class="btn-ghost btn-sm"><Icon name="flagNo" class="size-3.5" />Flag as Not a Table</button>
          <button data-bulk="none" class="btn-ghost btn-sm">Clear Flag</button>
          <button data-bulk="delete" class="btn-ghost btn-sm"><Icon name="trash" class="size-3.5" />Delete</button>
          <button data-bulk="restore" class="btn-ghost btn-sm"><Icon name="restore" class="size-3.5" />Restore</button>
          <span class="w-px h-5 bg-ink-200 mx-0.5" role="separator"></span>
          <div class="relative" data-menu>
            <button class="btn-primary btn-sm" data-menu-toggle><Icon name="download" class="size-3.5" />Export<Icon name="chevron" class="size-3" /></button>
            <div class="menu hidden right-0 w-72">
              <button data-export="xlsx" class="menu-item">Excel Workbook (.xlsx)<span class="ml-auto text-[11px] text-ink-500">one sheet per table</span></button>
              <button data-export="zip" class="menu-item">CSV Files (.zip)</button>
              <button data-export="json" class="menu-item">JSON</button>
              <label class="flex items-center gap-lg px-3 py-2 mt-1 border-t border-ink-100 text-[12px] text-ink-700" data-keep-open>
                <input id="ex-title" type="checkbox" class="accent-brand-700" />Write the title above each table (Excel)</label>
            </div>
          </div>
        </div>
      </div>
      <div id="list" role="list" class="flex flex-col gap-lg"></div>
      <div class="py-5 text-center"><button id="more" class="btn-line hidden">Load More</button></div>
    </section>

    <!-- preview (list-detail; HIG: details inline, not in a dialog). Below xl it opens as a side drawer. -->
    <aside id="preview" aria-label="Table preview"
      class="hidden xl:flex xl:sticky xl:top-4 xl:w-[30rem] shrink-0 flex-col panel max-h-[calc(100dvh-2rem)]
             max-xl:fixed max-xl:inset-y-0 max-xl:right-0 max-xl:z-40 max-xl:w-[min(34rem,94vw)] max-xl:shadow-2xl max-xl:max-h-none"></aside>
  </div>
</Layout>

<script>
  import { api, ENGINE_NAME, type State, type Table, type TableSearch } from '../lib/api';
  import { tableHTML } from '../lib/editor';
  import { $, $$, esc, toast, toastError, plural, initMenus, KIND_LABEL, debounce, ago, contextMenu, isMenuKey, type MenuItem } from '../lib/ui';
  import { icon } from '../lib/icons';
  import { UNCAT, catLabel, pathKey } from '../lib/categories';
  import { getSettings } from '../lib/settings';

  initMenus();
  const settings = getSettings();
  $<HTMLInputElement>('#ex-title').checked = settings.exportTitle;
  const STATE_LABEL: Record<State, string> = { none: 'Unflagged', valid: 'Valid', invalid: 'Not a table', deleted: 'Deleted' };
  const STATES: State[] = ['valid', 'none', 'invalid', 'deleted'];
  const stateIcon = (s: State) =>
    s === 'valid' ? `<span class="text-emerald-600 shrink-0">${icon('flagOk', 'size-4')}</span>`
    : s === 'invalid' ? `<span class="text-ink-400 shrink-0">${icon('flagNo', 'size-4')}</span>`
    : s === 'deleted' ? `<span class="text-red-600 shrink-0">${icon('trash', 'size-4')}</span>`
    : `<span class="text-ink-300 shrink-0">${icon('dot', 'size-4')}</span>`;
  const stateBadge = (s: State) => `<span class="chip ${s === 'valid' ? 'border-emerald-600/40 text-emerald-700' : s === 'deleted' ? 'border-red-200 text-red-700' : 'border-ink-200 text-ink-600'}">${stateIcon(s).replace('size-4', 'size-3')}${STATE_LABEL[s]}</span>`;

  // ---------------------------------------------------------------- state (mirrored in the URL)
  const p = new URLSearchParams(location.search);
  const f = {
    state: (p.get('state') ?? 'valid').split(',').filter(Boolean) as State[],
    edited: p.get('edited') === '1',
    kinds: (p.get('kinds') ?? '').split(',').filter(Boolean),
    docs: (p.get('docs') ?? '').split(',').filter(Boolean),
    q: p.get('q') ?? '',
    sort: p.get('sort') ?? 'document',
  };
  $<HTMLInputElement>('#q').value = f.q;
  $<HTMLSelectElement>('#sort').value = f.sort;

  let items: Table[] = [];
  let total = 0;
  let last: TableSearch | null = null;
  let current: string | null = p.get('table');
  const picked = new Set<string>();

  function syncUrl() {
    const u = new URLSearchParams();
    u.set('state', f.state.join(','));
    if (f.edited) u.set('edited', '1');
    if (f.kinds.length) u.set('kinds', f.kinds.join(','));
    if (f.docs.length) u.set('docs', f.docs.join(','));
    if (f.q) u.set('q', f.q);
    if (f.sort !== 'document') u.set('sort', f.sort);
    if (current) u.set('table', current);
    history.replaceState(null, '', `?${u}`);
  }

  async function load(append = false) {
    syncUrl();
    if (!append) $('#list').innerHTML = skeleton();
    try {
      const r = await api.searchTables({
        state: f.state.join(',') || 'none,valid,invalid,deleted', edited: f.edited ? true : '', docs: f.docs.join(','),
        kinds: f.kinds.join(','), q: f.q, sort: f.sort, offset: append ? items.length : 0, limit: 20,
      });
      last = r;
      total = r.total;
      items = append ? [...items, ...r.items] : r.items;
      renderFacets(r);
      renderList();
      if (current && !append) renderPreview();
    } catch (e: any) {
      $('#list').innerHTML = `<div class="panel p-8 text-center text-[13px]"><p class="text-red-700">${esc(e.message)}</p><button id="retry" class="btn-primary mt-3">Retry</button></div>`;
      $('#retry').addEventListener('click', () => load());
    }
  }

  const skeleton = () => Array.from({ length: 3 }).map(() =>
    `<div class="panel p-3 flex gap-grid"><div class="skeleton w-40 h-28"></div><div class="flex-1 space-y-2"><div class="skeleton h-4 w-2/3"></div><div class="skeleton h-3 w-1/3"></div></div></div>`).join('');

  function check(name: string, value: string, on: boolean, label: string, count: number, lead = '') {
    return `<label class="flex items-center gap-lg px-2 ${name === 'doc' ? 'min-h-8 py-0.5 pl-6' : 'h-8'} text-[13px] hover:bg-ink-50 ${count || on ? 'text-ink-800' : 'text-ink-500'}">
      <input type="checkbox" data-${name}="${esc(value)}" ${on ? 'checked' : ''} class="accent-brand-700" />${lead}
      <span class="flex-1 min-w-0 ${name === 'doc' ? 'line-clamp-2 leading-tight py-0.5' : 'truncate'}" title="${esc(label)}">${esc(label)}</span>
      <span class="text-[11px] tabular-nums text-ink-500" aria-label="${count} tables">${count}</span></label>`;
  }

  function renderFacets(r: TableSearch) {
    $('#f-state').innerHTML = STATES.map((s) => check('state', s, f.state.includes(s), STATE_LABEL[s], r.facets.state[s] ?? 0, stateIcon(s))).join('');
    $('#f-edited').innerHTML = check('edited', '1', f.edited, 'Edited only', r.facets.edited, `<span class="text-accent-600">${icon('edit', 'size-3.5')}</span>`);
    const kinds = ['publication', 'pressrelease', 'upload'];
    $('#f-kind').innerHTML = kinds.map((k) => check('kind', k, f.kinds.includes(k), KIND_LABEL[k]!, r.facets.kinds[k] ?? 0)).join('');
    renderDocFacet(r);
  }

  /** documents grouped by category (full path); a group checkbox selects every document in it */
  function renderDocFacet(r: TableSearch) {
    const dq = $<HTMLInputElement>('#f-docq').value.trim().toLowerCase();
    const docs = r.facets.docs.filter((d) => !dq || d.title.toLowerCase().includes(dq) || catLabel(d.category ?? []).toLowerCase().includes(dq));
    const groups = new Map<string, typeof docs>();
    for (const d of docs) { const k = pathKey(d.category ?? []); groups.set(k, [...(groups.get(k) ?? []), d]); }
    const keys = [...groups.keys()].sort((a, b) => {
      const pa = JSON.parse(a) as string[], pb = JSON.parse(b) as string[];
      return Number(!pa.length) - Number(!pb.length) || catLabel(pa).localeCompare(catLabel(pb), 'id');
    });
    $('#f-docs').innerHTML = keys.map((k) => {
      const path = JSON.parse(k) as string[];
      const ds = groups.get(k)!;
      const n = ds.filter((d) => f.docs.includes(d.id)).length;
      const total = ds.reduce((a, d) => a + d.count, 0);
      return `<div role="group" aria-label="${esc(catLabel(path))}">
        <label class="flex items-start gap-lg px-2 pt-1.5 pb-0.5 text-[11.5px] font-semibold text-ink-600 hover:bg-ink-50" title="${esc(catLabel(path))}">
          <input type="checkbox" data-docgroup="${esc(ds.map((d) => d.id).join(','))}" ${n && n === ds.length ? 'checked' : ''} ${n && n < ds.length ? 'data-mixed="1"' : ''} class="accent-brand-700 mt-0.5" />
          ${icon(path.length ? 'folder' : 'inbox', 'size-3.5 text-ink-400 mt-0.5')}
          <span class="flex-1 min-w-0 leading-tight">${path.length ? path.map(esc).join('<span class="text-ink-300"> / </span>') : UNCAT}</span>
          <span class="text-[11px] font-normal tabular-nums text-ink-500">${total}</span></label>
        ${ds.map((d) => check('doc', d.id, f.docs.includes(d.id), d.title, d.count)).join('')}</div>`;
    }).join('') || `<div class="px-2 py-2 text-[12px] text-ink-500">${dq ? 'No document matches.' : 'No documents yet.'}</div>`;
    $$<HTMLInputElement>('[data-mixed]', $('#f-docs')).forEach((i) => (i.indeterminate = true));
  }
  $('#f-docq').addEventListener('input', debounce(() => last && renderDocFacet(last), 120));

  const pagesOf = (t: Table) => t.pages ?? [t.page];
  const pageText = (t: Table) => { const ps = pagesOf(t); return ps.length > 1 ? `pages ${ps[0]}–${ps.at(-1)}` : `page ${t.page}`; };
  function areaText(t: Table) {
    const [pw, ph] = t.document!.page_size;
    const [x0, y0, x1, y1] = t.bbox;
    if (x1 - x0 <= 0) return 'added by hand, no area on the PDF';
    const pct = (v: number, m: number) => Math.round((100 * v) / m);
    return `${pct(y0, ph)}–${pct(y1, ph)}% down the page, ${pct(x0, pw)}–${pct(x1, pw)}% across`;
  }

  function card(t: Table) {
    const s = t.state!;
    const d = t.document!;
    const w = Math.max(0, ...t.rows.map((r) => r.length));
    const hasBox = t.bbox[2] - t.bbox[0] > 0;
    const isCur = t.id === current;
    return `<div role="listitem" data-card="${t.id}" class="panel flex ${isCur ? '!border-brand-600 shadow-[inset_3px_0_0_var(--color-brand-600)]' : picked.has(t.id) ? '!border-brand-300' : ''}">
      <label class="w-9 shrink-0 flex justify-center pt-3.5 border-r border-ink-100" title="Select for bulk actions">
        <input type="checkbox" data-pick="${t.id}" ${picked.has(t.id) ? 'checked' : ''} class="accent-brand-700" aria-label="Select ${esc(t.title || 'untitled table')}" /></label>
      <div class="w-40 shrink-0 bg-ink-50 border-r border-ink-100 p-1.5 grid place-items-center overflow-hidden" aria-hidden="true">
        ${hasBox ? `<img src="${api.snapshotUrl(t.id, t.bbox, 1)}" loading="lazy" alt="" class="max-h-32 max-w-full object-contain bg-[#fff]" />` : `<span class="text-ink-300">${icon('table', 'size-7')}</span>`}
      </div>
      <div class="flex-1 min-w-0 p-3 flex flex-col gap-sm">
        <div class="flex items-start gap-lg">
          <h3 class="flex-1 min-w-0 text-[13.5px] leading-snug ${isCur ? 'font-semibold' : 'font-medium'} ${t.title ? 'text-ink-900' : 'text-ink-500 italic'} ${s === 'deleted' ? 'line-through' : ''}">
            <button data-open="${t.id}" class="text-left hover:text-brand-700 line-clamp-2" aria-describedby="src-${t.id}">${esc(t.title || 'Untitled table')}</button></h3>
          <button data-menu-for="${t.id}" class="btn-ghost btn-sm btn-icon -mr-1 -mt-1 shrink-0" title="Actions for this table (Menu key)">${icon('layers', 'size-4')}</button>
        </div>
        ${t.notes ? `<p class="text-[12px] text-ink-600 line-clamp-1">${esc(t.notes.split('\n')[0])}</p>` : ''}
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[12px] text-ink-600 mt-auto" id="src-${t.id}">
          ${stateBadge(s)}
          ${t.edited ? `<span class="chip border-accent-400/60 text-accent-600 bg-orange-50">${icon('edit', 'size-3')}edited</span>` : ''}
          <span class="tabular-nums">${t.rows.length} × ${w}</span>
          <span class="min-w-0 truncate max-w-80">${esc(KIND_LABEL[d.kind] ?? d.kind)} · ${esc(d.title)}</span>
          <span class="tabular-nums font-medium text-ink-800">${pageText(t)}</span>
          <a href="/doc?id=${d.id}&table=${t.id}" class="ml-auto btn-line btn-sm">${icon('target', 'size-3.5')}Open in PDF</a>
        </div>
      </div>
    </div>`;
  }

  function renderList() {
    $('#summary').textContent = total ? plural(total, 'table') : '';
    $('#list').innerHTML = items.map(card).join('') || emptyState();
    $('#more').classList.toggle('hidden', items.length >= total);
    $('#more').textContent = `Load More (${total - items.length} left)`;
    renderBulk();
  }

  function emptyState() {
    const onlyValid = f.state.length === 1 && f.state[0] === 'valid';
    const unflagged = last?.facets.state.none ?? 0;
    return `<div class="panel px-6 py-14 text-center">
      <div class="mx-auto grid place-items-center size-12 bg-ink-50 border border-ink-200 text-ink-400 mb-3" aria-hidden="true">${icon('grid', 'size-6')}</div>
      <h2 class="font-medium text-ink-900">${onlyValid ? 'No valid tables yet' : 'No tables match the filters'}</h2>
      <p class="text-[13px] text-ink-600 mt-1 mb-4">${onlyValid
        ? `Tables show up here after you flag them as valid.${unflagged ? ` ${plural(unflagged, 'table is', 'tables are')} waiting for a flag.` : ''}`
        : 'Try other flags, source types or documents.'}</p>
      ${onlyValid && unflagged ? '<button data-empty="unflagged" class="btn-primary">Review Unflagged Tables</button>' : '<button data-empty="reset" class="btn-line">Reset Filters</button>'}
    </div>`;
  }

  function renderBulk() {
    $('#bulk').classList.toggle('hidden', !picked.size);
    $('#bulkn').textContent = `${picked.size} selected`;
    const all = items.length > 0 && items.every((t) => picked.has(t.id));
    $<HTMLInputElement>('#selall').checked = all;
    $<HTMLInputElement>('#selall').indeterminate = !all && items.some((t) => picked.has(t.id));
  }

  // ---------------------------------------------------------------- preview pane (list-detail)
  async function openPreview(id: string) {
    current = id;
    syncUrl();
    renderList();
    await renderPreview();
    if (!matchMedia('(min-width: 1280px)').matches) $('#preview').querySelector<HTMLElement>('[data-close]')?.focus();
  }

  async function renderPreview() {
    const pane = $('#preview');
    if (!current) {
      pane.innerHTML = `<div class="flex-1 grid place-items-center text-center p-8 text-[13px] text-ink-600">
        <div><div class="mx-auto grid place-items-center size-10 bg-ink-50 border border-ink-200 text-ink-400 mb-2" aria-hidden="true">${icon('table', 'size-5')}</div>
        Choose a table to see it next to its area on the PDF.</div></div>`;
      pane.classList.remove('max-xl:flex');
      return;
    }
    let t: Table;
    try { t = await api.table(current); } catch (e) { toastError(e, renderPreview); return; }
    const d = t.document!;
    const s = t.state!;
    const hasBox = t.bbox[2] - t.bbox[0] > 0;
    pane.classList.add('max-xl:flex');
    pane.innerHTML = `
      <div class="flex items-start gap-lg px-4 pt-3 pb-2 border-b border-ink-200">
        <div class="flex-1 min-w-0">
          <h2 class="font-semibold text-ink-900 leading-snug">${esc(t.title || 'Untitled table')}</h2>
          <p class="text-[12px] text-ink-600 mt-0.5">${esc(KIND_LABEL[d.kind] ?? d.kind)} · ${esc(d.title)}</p>
          <p class="text-[12px] text-ink-600">${pageText(t)} of ${d.page_count} · ${areaText(t)} · ${esc(ENGINE_NAME[t.engine] ?? t.engine)}${t.edited ? ' · edited' : ''}</p>
        </div>
        <button data-close class="btn-ghost btn-sm btn-icon" title="Close preview (Esc)">${icon('x')}</button>
      </div>
      <div class="flex flex-wrap items-center gap-md px-4 py-2 border-b border-ink-100">
        <div class="flex items-center border border-ink-200 h-7" role="radiogroup" aria-label="Flag">
          ${(['none', 'valid', 'invalid'] as const).map((v) => `<label class="flag-opt"><input type="radio" name="pflag" value="${v}" ${t.status === v ? 'checked' : ''} ${t.deleted ? 'disabled' : ''} class="sr-only" />${v === 'valid' ? icon('flagOk', 'size-3.5') : v === 'invalid' ? icon('flagNo', 'size-3.5') : ''}${v === 'none' ? 'Unflagged' : v === 'valid' ? 'Valid' : 'Not a Table'}</label>`).join('')}
        </div>
        <a href="/doc?id=${d.id}&table=${t.id}" class="btn-primary btn-sm ml-auto">${icon('target', 'size-3.5')}Open in PDF</a>
        ${s === 'deleted' ? `<button data-restore class="btn-line btn-sm">${icon('restore', 'size-3.5')}Restore</button>`
          : `<button data-del class="btn-ghost btn-sm" title="Delete (can be undone)">${icon('trash', 'size-3.5')}Delete</button>`}
      </div>
      <div class="flex-1 min-h-0 overflow-auto p-4 space-y-3">
        <section aria-label="Area on the PDF">
          <h3 class="label">On the PDF</h3>
          ${hasBox ? `<div class="text-[11px] text-ink-500 mb-1">Page ${t.page}</div><img src="${api.snapshotUrl(t.id, t.bbox, 1.6)}" alt="Table area on page ${t.page}" class="bg-[#fff] border border-ink-200 max-w-full" />` : '<p class="text-[12.5px] text-ink-500">Added by hand, no area on the PDF.</p>'}
          ${(t.parts ?? []).map((x, k) => `<div class="text-[11px] text-ink-500 mt-2 mb-1">Page ${x.page} · part ${k + 2}${x.skipped ? ` · ${plural(x.skipped, 'repeated header row')} dropped` : ''}</div>
            <img src="${api.snapshotUrl(t.id, x.bbox, 1.6, k + 1)}" alt="Part ${k + 2} on page ${x.page}" class="bg-[#fff] border border-ink-200 max-w-full" />`).join('')}
          ${d.source_pdf ? `<a href="${esc(d.source_pdf)}" target="_blank" rel="noopener" class="inline-flex items-center gap-sm text-[12px] text-brand-600 hover:underline mt-2">${icon('external', 'size-3.5')}Original PDF on BPS</a>` : ''}
        </section>
        <section aria-label="Extracted table">
          <h3 class="label">Extracted (${plural(t.rows.length, 'row')})</h3>
          <div class="overflow-auto border border-ink-100">${tableHTML(t)}</div>
          ${t.notes ? `<p class="text-[12px] text-ink-700 whitespace-pre-line border-l-2 border-ink-200 pl-3 mt-2">${esc(t.notes)}</p>` : ''}
        </section>
      </div>`;
  }

  $('#preview').addEventListener('click', async (e) => {
    const b = e.target as HTMLElement;
    if (b.closest('[data-close]')) { closePreview(); return; }
    if (b.closest('[data-del]')) act([current!], 'delete');
    if (b.closest('[data-restore]')) act([current!], 'restore');
  });
  $('#preview').addEventListener('change', (e) => {
    const r = e.target as HTMLInputElement;
    if (r.name === 'pflag') act([current!], r.value as 'valid');
  });
  function closePreview() {
    const back = current;
    current = null;
    syncUrl();
    renderList();
    renderPreview();
    $(`[data-open="${back}"]`)?.focus();
  }
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && current && !document.querySelector('[role=menu]')) closePreview(); });

  // ---------------------------------------------------------------- actions (undo instead of confirmation)
  async function act(ids: string[], action: 'valid' | 'invalid' | 'none' | 'delete' | 'restore') {
    try {
      const r = await api.bulk(ids, action);
      picked.clear();
      await load();
      if (action === 'delete') toast(`${plural(r.changed, 'table')} deleted`, 'info', { action: { label: 'Undo', run: () => act(ids, 'restore') } });
    } catch (e: any) { toastError(e, () => act(ids, action)); }
  }

  function cardMenu(at: MouseEvent | HTMLElement, id: string) {
    const t = items.find((x) => x.id === id)!;
    const ids = picked.has(id) && picked.size > 1 ? [...picked] : [id];
    const many = ids.length > 1;
    const items2: MenuItem[] = [
      { heading: many ? `${ids.length} tables selected` : t.title || 'Untitled table' },
      ...(many ? [] : [
        { label: 'Preview', icon: 'table', hint: 'Enter', action: () => openPreview(id) },
        { label: 'Open in PDF', icon: 'target', action: () => (location.href = `/doc?id=${t.document!.id}&table=${id}`) },
        'sep' as const,
      ]),
      { label: 'Flag as Valid', icon: 'flagOk', disabled: !many && t.status === 'valid', action: () => act(ids, 'valid') },
      { label: 'Flag as Not a Table', icon: 'flagNo', disabled: !many && t.status === 'invalid', action: () => act(ids, 'invalid') },
      { label: 'Clear Flag', icon: 'dot', disabled: !many && t.status === 'none', action: () => act(ids, 'none') },
      'sep',
      { label: `Export ${many ? `${ids.length} Tables` : 'Table'} to Excel`, icon: 'download', action: () => (location.href = api.manyExportUrl(ids, 'xlsx', settings.decimal, settings.exportTitle)) },
      'sep',
      !many && t.deleted
        ? { label: 'Restore', icon: 'restore', action: () => act(ids, 'restore') }
        : { label: many ? `Delete ${ids.length} Tables` : 'Delete', icon: 'trash', danger: true, action: () => act(ids, 'delete') },
    ];
    contextMenu(at, items2);
  }

  // ---------------------------------------------------------------- events
  $('aside').addEventListener('change', (e) => {
    const i = e.target as HTMLInputElement;
    const toggle = <T,>(arr: T[], v: T) => (i.checked ? [...new Set([...arr, v])] : arr.filter((x) => x !== v));
    if (i.dataset.state) f.state = toggle(f.state, i.dataset.state as State);
    else if (i.dataset.edited) f.edited = i.checked;
    else if (i.dataset.kind) f.kinds = toggle(f.kinds, i.dataset.kind);
    else if (i.dataset.doc) f.docs = toggle(f.docs, i.dataset.doc);
    else if (i.dataset.docgroup) {
      const ids = i.dataset.docgroup.split(',');
      f.docs = i.checked ? [...new Set([...f.docs, ...ids])] : f.docs.filter((x) => !ids.includes(x));
    } else return; // e.g. the document finder
    picked.clear();
    load();
  });
  const resetFilters = () => { Object.assign(f, { state: ['valid'], edited: false, kinds: [], docs: [], q: '' }); $<HTMLInputElement>('#q').value = ''; load(); };
  $('#reset').addEventListener('click', resetFilters);
  $('#q').addEventListener('input', debounce(() => { f.q = $<HTMLInputElement>('#q').value.trim(); load(); }, 250));
  $('#sort').addEventListener('change', () => { f.sort = $<HTMLSelectElement>('#sort').value; load(); });
  $('#more').addEventListener('click', () => load(true));
  $('#selall').addEventListener('change', () => {
    const on = $<HTMLInputElement>('#selall').checked;
    items.forEach((t) => (on ? picked.add(t.id) : picked.delete(t.id)));
    renderList();
  });

  $('#list').addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const empty = t.closest<HTMLElement>('[data-empty]');
    if (empty) { empty.dataset.empty === 'unflagged' ? (f.state = ['none'], load()) : resetFilters(); return; }
    const open = t.closest<HTMLElement>('[data-open]');
    if (open) return void openPreview(open.dataset.open!);
    const m = t.closest<HTMLElement>('[data-menu-for]');
    if (m) return cardMenu(m, m.dataset.menuFor!);
    // clicking the card body (not a link or control) previews it
    const c = t.closest<HTMLElement>('[data-card]');
    if (c && !t.closest('a,button,input,label')) openPreview(c.dataset.card!);
  });
  $('#list').addEventListener('contextmenu', (e) => {
    const c = (e.target as HTMLElement).closest<HTMLElement>('[data-card]');
    if (c && !(e.target as HTMLElement).closest('a')) cardMenu(e, c.dataset.card!);
  });
  // keyboard: ↑↓ between cards, Menu key / Shift+F10 for actions
  $('#list').addEventListener('keydown', (e) => {
    const c = (e.target as HTMLElement).closest<HTMLElement>('[data-card]');
    if (!c) return;
    if (isMenuKey(e)) { e.preventDefault(); cardMenu(c, c.dataset.card!); return; }
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      const cards = $$<HTMLElement>('[data-card]');
      const next = cards[cards.indexOf(c) + (e.key === 'ArrowDown' ? 1 : -1)];
      if (next) { e.preventDefault(); next.querySelector<HTMLElement>('[data-open]')!.focus(); }
    }
  });
  $('#list').addEventListener('change', (e) => {
    const i = e.target as HTMLInputElement;
    if (!i.dataset.pick) return;
    i.checked ? picked.add(i.dataset.pick) : picked.delete(i.dataset.pick);
    i.closest('[data-card]')!.classList.toggle('!border-brand-300', i.checked);
    renderBulk();
  });
  $$('[data-bulk]').forEach((b) => b.addEventListener('click', () => act([...picked], b.dataset.bulk as 'valid')));
  $$('[data-export]').forEach((b) => b.addEventListener('click', () => {
    location.href = api.manyExportUrl([...picked], b.dataset.export as 'xlsx' | 'zip' | 'json', settings.decimal, $<HTMLInputElement>('#ex-title').checked);
  }));

  renderPreview();
  load();
</script>
